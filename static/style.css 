body {
  font-family: Arial, sans-serif;
  margin: 0;
  background: #f5f7fb;
  color: #222;
}

header {
  background: #1f4e79;
  color: white;
  padding: 12px 16px;
}

nav a {
  color: white;
  margin-right: 12px;
  text-decoration: none;
}

main {
  padding: 20px;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 10px;
  max-width: 500px;
}

.grid {
  display: grid;
  gap: 10px;
}

input, button {
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 6px;
}

button {
  background: #1f4e79;
  color: white;
  cursor: pointer;
}

.flash {
  background: #fff3cd;
  padding: 10px;
  margin-bottom: 15px;
  border: 1px solid #ffeeba;
  border-radius: 6px;
}
